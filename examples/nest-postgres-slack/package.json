    "@opentelemetry/sdk-node": "^0.301.0",
    "@opentelemetry/sdk-trace": "^3.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.0.3",
    "@types/node": "^24.19.1",
    "@types/supertest": "^7.0.0",
